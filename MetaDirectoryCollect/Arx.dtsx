                    <arrayElement
                      dataType="System.String"><![CDATA[using Microsoft.SqlServer.Dts.Pipeline;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

static class Helpers
{
    public static void SetOutputBufferValue(this ScriptBuffer buffer, string bufferProp, object obj, string objProp)
    {
        var objType = obj.GetType();
        var objInfo = objType.GetProperty(objProp);
        var value = objInfo.GetValue(obj);
        var bufferType = buffer.GetType();
        if (!IsNull(value))
        {
            var bufferInfo = bufferType.GetProperty(bufferProp);
            if (bufferInfo != null)
            {
                bufferInfo.SetValue(buffer, value, null);
            }
        }
        else
        {
            var bufferInfo = bufferType.GetProperty($"{bufferProp}_IsNull");
            if (bufferInfo != null)
            {
                bufferInfo.SetValue(buffer, true, null);
            }
        }
    }


    private static bool IsNull(object value)
    {
        return value == null || (value is string s && string.IsNullOrWhiteSpace(s));
    }
}

