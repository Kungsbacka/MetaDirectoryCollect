                    <arrayElement
                      dataType="System.String"><![CDATA[using System;
using System.DirectoryServices;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPoint]
public class ScriptMain : UserComponent
{
    public override void CreateNewOutputRows()
    {
        string filter = "(&(objectCategory=person)(objectClass=user))";
        string[] attributes = {
            "accountExpires"
          , "cn"
          , "company"
          , "department"
          , "departmentNumber"
          , "description"
          , "displayName"
          , "distinguishedName"
          , "employeeNumber"
          , "employeeType"
          , "extensionAttribute1"
          , "extensionAttribute2"
          , "extensionAttribute3"
          , "extensionAttribute4"
          , "extensionAttribute5"
          , "extensionAttribute6"
          , "extensionAttribute7"
          , "extensionAttribute8"
          , "extensionAttribute9"
          , "extensionAttribute10"
          , "extensionAttribute11"
          , "extensionAttribute12"
          , "extensionAttribute13"
          , "extensionAttribute14"
          , "extensionAttribute15"
          , "flags"
          , "gidNumber"
          , "givenName"
          , "initials"
          , "l"
          , "lastLogonTimestamp"
          , "mail"
          , "manager"
          , "mobile"
          , "msExchRecipientDisplayType"
          , "msExchRecipientTypeDetails"
          , "msExchRemoteRecipientType"
          , "msDS-cloudExtensionAttribute1"
          , "msDS-cloudExtensionAttribute2"
          , "msDS-cloudExtensionAttribute3"
          , "msDS-cloudExtensionAttribute4"
          , "msDS-cloudExtensionAttribute5"
          , "msDS-cloudExtensionAttribute6"
          , "msDS-cloudExtensionAttribute7"
          , "msDS-cloudExtensionAttribute8"
          , "msDS-cloudExtensionAttribute9"
          , "msDS-cloudExtensionAttribute10"
          , "msDS-cloudExtensionAttribute11"
          , "msDS-cloudExtensionAttribute12"
          , "msDS-cloudExtensionAttribute13"
          , "msDS-cloudExtensionAttribute14"
          , "msDS-cloudExtensionAttribute15"
          , "msDS-cloudExtensionAttribute16"
          , "msDS-cloudExtensionAttribute17"
          , "msDS-cloudExtensionAttribute18"
          , "msDS-cloudExtensionAttribute19"
          , "msDS-cloudExtensionAttribute20"
          , "objectGUID"
          , "physicalDeliveryOfficeName"
          , "postalCode"
          , "proxyAddresses"
          , "sAMAccountName"
          , "seeAlso"
          , "sn"
          , "streetAddress"
          , "telephoneNumber"
          , "title"
          , "userAccountControl"
          , "userPrincipalName"
          , "uSNChanged"
          , "uSNCreated"
          , "whenChanged"
          , "whenCreated"
        };
        string domainController = string.Empty;
        using (DirectoryEntry rootDse = new DirectoryEntry("LDAP://rootDSE"))
        {
            domainController = (string)rootDse.Properties["dnsHostName"].Value;
        }
        string[] searchBase = Variables.ActiveDirectorySearchBase.Split(';');
        foreach (string path in searchBase)
        {
            string pathWithServer = "LDAP://" + domainController + "/" + path.Substring(7);
            using (DirectoryEntry searchRoot = new DirectoryEntry(pathWithServer))
            {
                using (DirectorySearcher searcher = new DirectorySearcher(searchRoot, filter, attributes))
                {
                    searcher.PageSize = 1000;
                    searcher.ReferralChasing = ReferralChasingOption.None;
                    using (SearchResultCollection result = searcher.FindAll())
                    {
                        foreach (SearchResult item in result)
                        {
                            UserBuffer.AddRow();
                            UserBuffer.domainController = domainController;
                            Guid objectGuid = new Guid((byte[])item.Properties["objectGUID"][0]);
                            UserBuffer.objectGUID = objectGuid;
                            UserBuffer.SetDateTimeColumnFromFileTime(item, "accountExpires");
                            UserBuffer.SetStringColumn(item, "cn");
                            UserBuffer.SetStringColumn(item, "company");
                            UserBuffer.SetStringColumn(item, "department");
                            UserBuffer.SetStringColumn(item, "departmentNumber");
                            UserBuffer.SetStringColumn(item, "description");
                            UserBuffer.SetStringColumn(item, "displayName");
                            UserBuffer.SetStringColumn(item, "distinguishedName");
                            UserBuffer.SetStringColumn(item, "employeeNumber");
                            UserBuffer.SetStringColumn(item, "employeeType");
                            UserBuffer.SetStringColumn(item, "extensionAttribute1");
                            UserBuffer.SetStringColumn(item, "extensionAttribute2");
                            UserBuffer.SetStringColumn(item, "extensionAttribute3");
                            UserBuffer.SetStringColumn(item, "extensionAttribute4");
                            UserBuffer.SetStringColumn(item, "extensionAttribute5");
                            UserBuffer.SetStringColumn(item, "extensionAttribute6");
                            UserBuffer.SetStringColumn(item, "extensionAttribute7");
                            UserBuffer.SetStringColumn(item, "extensionAttribute8");
                            UserBuffer.SetStringColumn(item, "extensionAttribute9");
                            UserBuffer.SetStringColumn(item, "extensionAttribute10");
                            UserBuffer.SetStringColumn(item, "extensionAttribute11");
                            UserBuffer.SetStringColumn(item, "extensionAttribute12");
                            UserBuffer.SetStringColumn(item, "extensionAttribute13");
                            UserBuffer.SetStringColumn(item, "extensionAttribute14");
                            UserBuffer.SetStringColumn(item, "extensionAttribute15");
                            UserBuffer.SetIntColumn(item, "flags");
                            UserBuffer.SetIntColumn(item, "gidNumber");
                            UserBuffer.SetStringColumn(item, "givenName");
                            UserBuffer.SetStringColumn(item, "initials");
                            UserBuffer.SetStringColumn(item, "localityName", "l");
                            UserBuffer.SetDateTimeColumnFromFileTime(item, "lastLogonTimestamp");
                            UserBuffer.SetStringColumn(item, "mail");
                            UserBuffer.SetStringColumn(item, "manager");
                            UserBuffer.SetStringColumn(item, "mobile");
                            UserBuffer.SetIntColumn(item, "msExchRecipientDisplayType");
                            UserBuffer.SetBigIntColumn(item, "msExchRecipientTypeDetails");
                            UserBuffer.SetBigIntColumn(item, "msExchRemoteRecipientType");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute1", "msDS-cloudExtensionAttribute1");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute2", "msDS-cloudExtensionAttribute2");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute3", "msDS-cloudExtensionAttribute3");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute4", "msDS-cloudExtensionAttribute4");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute5", "msDS-cloudExtensionAttribute5");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute6", "msDS-cloudExtensionAttribute6");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute7", "msDS-cloudExtensionAttribute7");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute8", "msDS-cloudExtensionAttribute8");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute9", "msDS-cloudExtensionAttribute9");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute10", "msDS-cloudExtensionAttribute10");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute11", "msDS-cloudExtensionAttribute11");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute12", "msDS-cloudExtensionAttribute12");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute13", "msDS-cloudExtensionAttribute13");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute14", "msDS-cloudExtensionAttribute14");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute15", "msDS-cloudExtensionAttribute15");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute16", "msDS-cloudExtensionAttribute16");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute17", "msDS-cloudExtensionAttribute17");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute18", "msDS-cloudExtensionAttribute18");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute19", "msDS-cloudExtensionAttribute19");
                            UserBuffer.SetStringColumn(item, "msDScloudExtensionAttribute20", "msDS-cloudExtensionAttribute20");
                            UserBuffer.SetStringColumn(item, "physicalDeliveryOfficeName");
                            UserBuffer.SetStringColumn(item, "postalCode");
                            UserBuffer.SetStringColumn(item, "sAMAccountName");
                            UserBuffer.SetStringColumn(item, "seeAlso");
                            UserBuffer.SetStringColumn(item, "sn");
                            UserBuffer.SetStringColumn(item, "streetAddress");
                            UserBuffer.SetStringColumn(item, "telephoneNumber");
                            UserBuffer.SetStringColumn(item, "title");
                            UserBuffer.SetIntColumn(item, "userAccountControl");
                            UserBuffer.SetStringColumn(item, "userPrincipalName");
                            UserBuffer.SetBigIntColumn(item, "uSNChanged");
                            UserBuffer.SetBigIntColumn(item, "uSNCreated");
                            UserBuffer.SetDateTimeColumnFromDateTime(item, "whenChanged");
                            UserBuffer.SetDateTimeColumnFromDateTime(item, "whenCreated");
                            if (item.Properties["proxyAddresses"].Count > 0)
                            {
                                foreach (string address in item.Properties["proxyAddresses"])
                                {
                                    if (address.StartsWith("smtp:", StringComparison.OrdinalIgnoreCase))
                                    {
                                        AddressBuffer.AddRow();
                                        AddressBuffer.objectGUID = objectGuid;
                                        AddressBuffer.address = address.Substring(5);
                                        AddressBuffer.uSNChanged = (long)item.Properties["uSNChanged"][0];
                                        AddressBuffer.primary = address.StartsWith("SMTP:", StringComparison.Ordinal);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}]]></arrayElement>
