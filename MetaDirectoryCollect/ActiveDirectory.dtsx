                      dataType="System.String"><![CDATA[using System;
using System.DirectoryServices;
using System.Reflection;

public static class Helpers
{
    public static void SetStringColumn(this UserBuffer outputBuffer, SearchResult result, string property)
    {
        SetStringColumn(outputBuffer, result, column: null, property);
    }

    public static void SetStringColumn(this UserBuffer outputBuffer, SearchResult result, string column, string property)
    {
        string value = null;
        if (result.Properties[property].Count == 1)
        {
            value = result.Properties[property][0] as string;
        }
        SetOutputBufferValue(outputBuffer, column, property, value);
    }

    public static void SetDateTimeColumnFromFileTime(this UserBuffer outputBuffer, SearchResult result, string property)
    {
        long value = -1;
        if (result.Properties[property].Count == 1)
        {
            value = (long)result.Properties[property][0];
        }
        if (value > 0 && value < long.MaxValue)
        {
            SetOutputBufferValue(outputBuffer, property, DateTime.FromFileTime(value));
        }
        else
        {
            SetOutputBufferValue(outputBuffer, property, null);
        }
    }

    public static void SetDateTimeColumnFromDateTime(this UserBuffer outputBuffer, SearchResult result, string property)
    {
        if (result.Properties[property].Count == 1)
        {
            SetOutputBufferValue(outputBuffer, property, (DateTime)result.Properties[property][0]);
        }
        else
        {
            SetOutputBufferValue(outputBuffer, property, null);
        }
    }


    public static void SetIntColumn(this UserBuffer outputBuffer, SearchResult result, string property)
    {
        if (result.Properties[property].Count == 1)
        {
            int value = (int)result.Properties[property][0];
            SetOutputBufferValue(outputBuffer, property, value);
        }
        else
        {
            SetOutputBufferValue(outputBuffer, property, null);
        }
    }

    public static void SetBigIntColumn(this UserBuffer outputBuffer, SearchResult result, string property)
    {
        if (result.Properties[property].Count == 1)
        {
            long value = (long)result.Properties[property][0];
            SetOutputBufferValue(outputBuffer, property, value);
        }
        else
        {
            SetOutputBufferValue(outputBuffer, property, null);
        }
    }

    private static void SetOutputBufferValue(UserBuffer outputBuffer, string property, object value)
    {
        SetOutputBufferValue(outputBuffer, column: null, property, value);
    }

    private static void SetOutputBufferValue(UserBuffer outputBuffer, string column, string property, object value)
    {
        var type = outputBuffer.GetType();
        var propertyName = column ?? property;
        if (value != null)
        {
            var propertyInfo = type.GetProperty(propertyName);
            propertyInfo?.SetValue(outputBuffer, value, null);
        }
        else
        {
            var propertyInfo = type.GetProperty($"{propertyName}_IsNull");
            propertyInfo?.SetValue(outputBuffer, true, null);
        }
    }
}]]></arrayElement>
