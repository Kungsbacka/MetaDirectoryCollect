                    <arrayElement
                      dataType="System.String"><![CDATA[using System;
using System.Data;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
using System.Collections.Generic;
using System.Xml.Serialization;
using System.IO;
using System.Net;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    public override void PreExecute()
    {
        base.PreExecute();
    }

    public override void PostExecute()
    {
        base.PostExecute();
    }

    private bool IsNull(object value)
    {
        if (value == null)
        {
            return true;
        }
        if (value is string && string.IsNullOrWhiteSpace((string)value))
        {
            return true;
        }
        return false;
    }

    public override void CreateNewOutputRows()
    {
        var fieldDict = new Dictionary<string, string>()
        {
            { "id",          "personId"    },
            { "first_name",  "firstName"   },
            { "last_name",   "lastName"    },
            { "description", "description" },
            { "domain",      "domain"      },
        };
        var extraFieldDict = new Dictionary<string, string>()
        {
            { "Förvaltning",    "extraForvaltning"    },
            { "Verksamhet",     "extraVerksamhet"     },
            { "Enhet",          "extraEnhet"          },
            { "Avdelning",      "extraAvdelning"      },
            { "Ansvarig chef",  "extraAnsvarigChef"   },
            { "Telefon",        "extraTelefon"        },
            { "e-post",         "extraEpost"          },
            { "Beredskapskort", "extraBeredskapskort" },
            { "extid",          "extraExtId"          },
            { "Kundnamn",       "extraKundnamn"       },
            { "Extern",         "extraExtern"         },
            { "Klar",           "extraKlar"           },
            { "Skola",          "extraSkola"          },
        };
        var cardFieldDict = new Dictionary<string, string>()
        {
            { "number",      "cardNumber"  },
            { "person_id",   "personId"    },
            { "format_name", "formatName"  },
            { "description", "description" }
        };
        var accessFieldDict = new Dictionary<string, string>()
        {
            { "name",       "accessName" },
            { "start_date", "startDate"  },
            { "end_date",   "endDate"    }
        };
        ServicePointManager.ServerCertificateValidationCallback = delegate { return true; }; // Ignore certificate errors
        ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls11; // Force TLS 1.1
        arxdata data;
        using (var wc = new WebClient())
        {
            wc.Credentials = new NetworkCredential(
                Variables.ArxApiUserName,
                Variables.ArxApiPassword);
            var xs = new XmlSerializer(typeof(arxdata));
            data = (arxdata)xs.Deserialize(wc.OpenRead(Variables.ArxApiExportUrl));
        }
        foreach (var person in data.persons)
        {
            PersonOutputBuffer.AddRow();
            foreach (string propertyName in fieldDict.Keys)
            {
                PersonOutputBuffer.SetOutputBufferValue(fieldDict[propertyName], person, propertyName);
            }
            foreach (var extraField in person.extra_fields)
            {
                string propertyName;
                if (extraFieldDict.TryGetValue(extraField.name, out propertyName))
                {
                    PersonOutputBuffer.SetOutputBufferValue(propertyName, extraField, "value");
                }
            }
            foreach (var access in person.access_categories)
            {
                AccessOutputBuffer.AddRow();
                AccessOutputBuffer.SetOutputBufferValue("personId", person, "id");
                foreach (string propertyName in accessFieldDict.Keys)
                {
                    AccessOutputBuffer.SetOutputBufferValue(accessFieldDict[propertyName], access, propertyName);
                }
            }
        }
        foreach (arxdataCard card in data.cards)
        {
            CardOutputBuffer.AddRow();
            foreach (string propertyName in cardFieldDict.Keys)
            {
                CardOutputBuffer.SetOutputBufferValue(cardFieldDict[propertyName], card, propertyName);
            }
        }
    }
}
]]></arrayElement>
